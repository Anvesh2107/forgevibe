# ── ForgeVibe Java — Environment Variables ─────────────────────────────────────
#
# Copy this file to .env and fill in values before running docker compose.
# All variables have safe defaults for local development.
#

# PostgreSQL (used by the backend service)
# Default values match docker-compose.yml — change in production!
POSTGRES_DB=forgevibe
POSTGRES_USER=forgevibe
POSTGRES_PASSWORD=forgevibe_secret

# OpenAI API Key (OPTIONAL)
# If blank: AI worker uses deterministic keyword-based mock scoring.
# If set:   AI worker calls GPT-4o-mini for real content moderation.
OPENAI_API_KEY=

# Kafka (internal — no need to change unless using external Kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
